# =========================================================================
# .env - YOUR SECRET KEYS GO HERE
# =========================================================================
# HOW TO GET THESE VALUES:
#
#   1. Go to https://supabase.com/dashboard
#   2. Click on your project (or create a new one)
#   3. In the left sidebar, click "Settings" (gear icon at the bottom)
#   4. Click "API" under the "Configuration" section
#   5. You'll see:
#       - "Project URL"        -> paste below as SUPABASE_URL
#       - "Project API keys"   -> copy "anon public" key -> paste as SUPABASE_KEY
#       - "Project API keys"   -> copy "service_role" key -> paste as SUPABASE_SERVICE_KEY
#
# WARNING: This file should NEVER be committed to git!
#          The .gitignore already handles this for you.
# =========================================================================

# -- Supabase Credentials -------------------------------------------------
# Replace these placeholder values with your real Supabase project values.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=https://sleeetyhanjtdftuzrqr.supabase.co/rest/v1/credentials
SUPABASE_SERVICE_KEY=your-service-role-key-here

# -- Flask Credentials -----------------------------------------------------
# FLASK_SECRET_KEY: Used by Flask to sign session cookies.
#   -> Replace with any long random string (e.g., mash your keyboard).

FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_DEBUG=True
FLASK_PORT=5000
